package org.j2os.personservice;
import org.j2os.entity.Person;
import org.j2os.personrepository.Personrepository;

import java.util.List;

public class Personservice {
    private static final Personservice PERSON_SERVICE = new Personservice();

    /*================================================
                   Stateless Pattern
     =================================================*/
    private Personservice(){}
    public static Personservice getInstance(){
        return PERSON_SERVICE;
    }
    /*=================================================
                CRUD METHODS
    =================================================== */
    public void save(Person person) throws Exception {
        Personrepository personrepository = new Personrepository(org.j2os.Common.ConnectionProvider.getConnection());
        personrepository.insert(person);
    }
    public void update(Person person) throws Exception{
        Personrepository personrepository=new Personrepository(org.j2os.Common.ConnectionProvider.getConnection());
        personrepository.update(person);
    }
    public void delete(Person person) throws Exception{
        Personrepository personrepository=new Personrepository(org.j2os.Common.ConnectionProvider.getConnection());
        personrepository.delete(person);
    }
    public List<Person> findAll() throws Exception{
        Personrepository personrepository=new Personrepository(org.j2os.Common.ConnectionProvider.getConnection());
        return personrepository.selectAll();
    }

}
